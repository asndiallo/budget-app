BETTER_AUTH_SECRET=<random 32+ char string>
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GITHUB_CLIENT_ID=...
GITHUB_CLIENT_SECRET=...
RESEND_API_KEY=<resend sending-access API key>
ALERTS_FROM_EMAIL=onboarding@resend.dev
ALERTS_TO_EMAIL=<email to receive the daily alert digest>

# Optional — overrides the default ./budget.db path. docker-compose.yml sets
# this itself (see README "Running on a home server"); no need to set it here
# unless you want the same relocation outside Docker.
# DB_PATH=/absolute/path/to/budget.db

# Optional — lib/auth.ts auto-detects your machine's LAN IP for accessing the
# app from your phone/other devices, so this normally isn't needed. Set it
# only if that detection picks the wrong interface (VPN, multiple NICs) or
# you're behind a tunnel.
# BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://192.168.1.x:3000